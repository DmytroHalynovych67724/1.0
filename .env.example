# HTTP server
PORT=3000
NODE_ENV=development

# SQLite database. Tests always override this with a temporary path.
DB_PATH=./data/db.sqlite

# Optional hosted database. When both values are present (except in tests),
# Turso is used instead of DB_PATH. Never commit the real token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Fill both secrets before seeding an admin or starting a deployment.
# JWT_SECRET must contain at least 32 bytes; ADMIN_PASSWORD at least 12.
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional comma-separated origins when the frontend is hosted separately.
CORS_ORIGIN=

# Optional free-tier AI for Pomocnik NaShary. Keep the real key only in a
# local .env file or the Render environment; never expose it as a VITE_ value.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Open Icecat product specifications. The public demo account works for trying
# the integration; replace it with your own free account and access tokens.
ICECAT_ENABLED=true
ICECAT_USERNAME=openIcecat-live
ICECAT_API_TOKEN=
ICECAT_CONTENT_TOKEN=
ICECAT_LANGUAGE=EN
